# === Sessão do Instagram (obrigatório para coleta) ===
# Pegue o valor do cookie "sessionid" de uma sessão logada no navegador.
INSTAGRAM_SESSIONID=

# Sessões extras (opcional, ajuda a evitar bloqueio em coletas maiores)
# INSTAGRAM_SESSIONID_2=
# INSTAGRAM_SESSIONID_3=

# === Cascata de classificação de IA (PASA) — configure ao menos 1 ===
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1   # opcional, para triagem local grátis
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ALIBABA_API_KEY=

# === Comportamento do Nimrod ===
NIMROD_MAX_POSTS=12
NIMROD_MAX_COMMENTS_PER_POST=150
NIMROD_MAX_AGE_DAYS=60
NIMROD_HEADLESS=true
NIMROD_ENABLE_LINGUISTICS=true
NIMROD_ENABLE_BEHAVIOR=true
NIMROD_ENABLE_CLUSTERING=true
NIMROD_AI_CONCURRENCY=5
NIMROD_OUTPUT_DIR=output

# === Notificação ao terminar (opcional, mesmo padrão dos outros projetos) ===
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
